{
  "manifest_version": 3,
  "name": "YouTube Bilingual Subtitles",
  "version": "1.6.0",
  "description": "Dịch phụ đề YouTube sang song ngữ realtime.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/watch*",
        "https://*.youtube.com/shorts*",
        "https://*.youtube.com/embed/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ]
    },
    {
      "matches": [
        "https://*.youtube.com/watch*"
      ],
      "js": [
        "content/transcript.js"
      ],
      "css": [
        "content/transcript.css"
      ]
    },
    {
      "matches": [
        "https://*.youtube.com/watch*"
      ],
      "js": [
        "content/yt-player-data.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-subtitles": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Bật/tắt dịch phụ đề"
    },
    "cycle-mode": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Xoay vòng chế độ hiển thị (bilingual / translated / original)"
    },
    "toggle-transcript": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Bật/tắt bảng transcript trong trang"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
